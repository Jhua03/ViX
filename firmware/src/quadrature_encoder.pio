.pio_version 0

.program quadrature_encoder

; Must be loaded at address 0 because computed jumps use the sampled AB state.
.origin 0

; Previous AB and current AB form a four-bit computed-jump index. Y stores the
; signed 32-bit count. The RX FIFO receives non-blocking snapshots of Y.

; previous 00
    JMP update
    JMP decrement
    JMP increment
    JMP invalid
; previous 01
    JMP increment
    JMP update
    JMP invalid
    JMP decrement
; previous 10
    JMP decrement
    JMP invalid
    JMP update
    JMP increment
; previous 11
    JMP invalid
    JMP increment

decrement:
    JMP Y--, update

.wrap_target
update:
    MOV ISR, Y
    PUSH noblock
sample_pins:
    OUT ISR, 2
    IN PINS, 2
    MOV OSR, ISR
    MOV PC, ISR
increment:
    MOV Y, ~Y
    JMP Y--, increment_cont
increment_cont:
    MOV Y, ~Y
    JMP update

; Impossible two-bit transition. Do not change the position count. IRQ flag 1
; is routed to the CPU, which increments a diagnostic counter. Since this path
; should be rare, an IRQ does not compromise high-rate normal decoding.
invalid:
    IRQ 1
    JMP update
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void quadrature_encoder_program_init(PIO pio, uint sm,
                                                    uint pin,
                                                    int max_step_rate) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, false);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    gpio_pull_up(pin);
    gpio_pull_up(pin + 1);

    pio_sm_config c = quadrature_encoder_program_get_default_config(0);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_jmp_pin(&c, pin);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    if (max_step_rate == 0) {
        sm_config_set_clkdiv(&c, 1.0f);
    } else {
        const float div = (float)clock_get_hz(clk_sys) /
                          (10.0f * (float)max_step_rate);
        sm_config_set_clkdiv(&c, div);
    }

    pio_sm_init(pio, sm, 0, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline int32_t quadrature_encoder_get_count(PIO pio, uint sm) {
    uint32_t value = 0;
    int entries = pio_sm_get_rx_fifo_level(pio, sm) + 1;
    while (entries-- > 0) {
        value = pio_sm_get_blocking(pio, sm);
    }
    return (int32_t)value;
}
%}
