        <mxCell id="v-c0db36eaeb" value="&lt;b&gt;D. Drive energise and fault&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#666666;fillColor=#f8f9fa;fontFamily=Helvetica;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="980" y="420" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v-350f835cc6" value="&lt;b&gt;Pico ENABLE GPIO&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO high requests enable&lt;br&gt;GPIO reset/low must disable" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9673a6;fillColor=#e1d5e7;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="190" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v-d20352e050" value="&lt;b&gt;NPN enable sink&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO ─ 2.2 kΩ ─ base&lt;br&gt;10 kΩ base-to-emitter&lt;br&gt;emitter → X4-3&lt;br&gt;collector → NC interlock → X4-11" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d6b656;fillColor=#fff2cc;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1260" y="500" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e-49651bed29" value="Enable request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;strokeWidth=2;strokeColor=#d6b656;fontColor=#806000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-350f835cc6" target="v-d20352e050">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-461393518f" value="&lt;b&gt;Fault input&lt;/b&gt;&lt;br&gt;&lt;br&gt;3.3 V ─ 10 kΩ ─ Pico FAULT GPIO&lt;br&gt;same node → X4-6&lt;br&gt;X4-3 → Pico/interface GND&lt;br&gt;&lt;br&gt;Healthy normally reads low; fault allows pull-up high. Verify during commissioning." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d6b656;fillColor=#fff2cc;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1000" y="720" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v-16fd7e3b14" value="&lt;b&gt;E. RS-232 diagnostics&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#666666;fillColor=#f8f9fa;fontFamily=Helvetica;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v-7a7f4e496d" value="&lt;b&gt;Pico UART&lt;/b&gt;&lt;br&gt;TX&lt;br&gt;RX&lt;br&gt;GND" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9673a6;fillColor=#e1d5e7;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="150" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v-5cdbeaf364" value="&lt;b&gt;MAX3232&lt;/b&gt;&lt;br&gt;3.3 V supply&lt;br&gt;charge-pump capacitors per datasheet" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9673a6;fillColor=#e1d5e7;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="830" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v-577f99c396" value="&lt;b&gt;ViX X3&lt;/b&gt;&lt;br&gt;4 Rx&lt;br&gt;5 Tx&lt;br&gt;3 GND&lt;br&gt;&lt;b&gt;2 NC&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6c8ebf;fillColor=#dae8fc;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="830" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e-9ef3310166" value="TTL UART" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;strokeWidth=2;strokeColor=#9673a6;fontColor=#6f4e7c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-7a7f4e496d" target="v-5cdbeaf364">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-99d4b5f2f1" value="RS-232&lt;br&gt;cross TX/RX" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#305b8c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-5cdbeaf364" target="v-577f99c396">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-2380b4e6a0" value="&lt;b&gt;Commissioning checks before motion&lt;/b&gt;&lt;br&gt;1) Drive OFF: verify all grounds and pin orientation. 2) Confirm STATUS resolution is 1,300,000 per 13 mm pitch and encoder direction is 100,000 counts/mm. 3) Manually actuate +EOT, −EOT and HOME and confirm Pico states. 4) Verify X4-11 cannot energise with Pico reset or interlock open. 5) Verify fault input changes during a controlled disabled/fault test. 6) First pulses must be low-rate and bounded at mid-travel." style="shape=note;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#d6b656;fillColor=#fff2cc;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="930" width="730" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
