        <mxCell id="v-8398ef659a" value="&lt;b&gt;Three identical channels&lt;/b&gt;&lt;br&gt;&lt;br&gt;3.3 V ─ 4.7 kΩ ─ signal&lt;br&gt;signal ─ Pico GPIO&lt;br&gt;sensor transistor sinks to GND&lt;br&gt;&lt;br&gt;Optional 1 nF–10 nF at GPIO only after debounce testing" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#d6b656;fillColor=#fff2cc;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="260" height="170" as="geometry" />
