  <diagram id="page-1dd5cae8d7" name="2 - Pin-by-pin connections">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v-3855d9ce7a" value="Pin-by-Pin Wiring — ViX AE/AH base drive, MX80L and Pico 2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v-3defe355c2" value="Use connector names and pin numbers, not wire position viewed from the wrong side of a D-sub. Verify continuity before power." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#4d4d4d;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="v-17dc3995c5" value="&lt;b&gt;ViX X1 — Power and motor&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;10&lt;/b&gt; +HV (24–80 V DC; XL +DC)&lt;br&gt;&lt;b&gt;9&lt;/b&gt; −HV / motor bus return (XL −DC; bond per manual)&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Protective earth&lt;br&gt;&lt;b&gt;7&lt;/b&gt; +24 V logic&lt;br&gt;&lt;b&gt;6&lt;/b&gt; 24 V logic 0 V&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Motor earth / shield clamp reference&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Motor U — MX80L red&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Motor V — MX80L white&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Motor W — MX80L black&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Brake output; normally unused for horizontal MX80L" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#666666;fillColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="v-2e72a835f5" value="&lt;b&gt;MX80L feedback / Hall cable&lt;/b&gt;&lt;br&gt;&lt;br&gt;The 10 nm option includes an interpolator box and bypass cable. The factory Hall/encoder cable is terminated with a high-density DB15 intended for the ViX X2 connector.&lt;br&gt;&lt;br&gt;&lt;b&gt;Action:&lt;/b&gt; plug the complete factory feedback assembly directly into ViX X2. Do not cut, swap, or recreate A/B/Hall pins unless continuity testing proves the factory cable has been modified.&lt;br&gt;&lt;br&gt;X2 carries encoder A/B/Z, +5 V, 0 V, Hall 1/2/3 and temperature." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#666666;fillColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="v-97cd2702f0" value="&lt;b&gt;MX80L limit/home cable — breakout to Pico&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DB15 pin 1&lt;/b&gt; Sensor GND — black&lt;br&gt;&lt;b&gt;DB15 pin 6&lt;/b&gt; + end-of-travel — orange&lt;br&gt;&lt;b&gt;DB15 pin 7&lt;/b&gt; − end-of-travel — blue&lt;br&gt;&lt;b&gt;DB15 pin 8&lt;/b&gt; Home — green&lt;br&gt;&lt;br&gt;Outputs are NPN open-collector current sinks. Use a DB15 breakout (VM15-PF or equivalent), connect pin 1 to interface/Pico GND, and pull pins 6/7/8 up to 3.3 V through 4.7 kΩ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Do not plug this cable into ViX AE/AH base drive X5.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#666666;fillColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="130" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="v-d4ccce4cc8" value="&lt;b&gt;ViX X4 — Step/direction command&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configure position mode and step/direction input:&lt;br&gt;&lt;b&gt;MP&lt;/b&gt;&lt;br&gt;&lt;b&gt;W(EI,0)&lt;/b&gt;&lt;br&gt;&lt;b&gt;W(ES,0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;12&lt;/b&gt; STEP+ / A+ input&lt;br&gt;&lt;b&gt;7&lt;/b&gt; STEP− / A− input&lt;br&gt;&lt;b&gt;13&lt;/b&gt; DIR+ / B+ input&lt;br&gt;&lt;b&gt;8&lt;/b&gt; DIR− / B− input&lt;br&gt;&lt;b&gt;11&lt;/b&gt; Energise input (active low with ES=0)&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Fault output (open collector)&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Control 0 V" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#666666;fillColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="v-8bb807eff8" value="&lt;b&gt;ViX X4 — Encoder copy to Pico&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configure encoder output as quadrature:&lt;br&gt;&lt;b&gt;W(EO,2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;14&lt;/b&gt; Encoder A+ output&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Encoder A− output&lt;br&gt;&lt;b&gt;15&lt;/b&gt; Encoder B+ output&lt;br&gt;&lt;b&gt;10&lt;/b&gt; Encoder B− output&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Encoder Z+ output&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Encoder Z− output&lt;br&gt;&lt;br&gt;Receive each differential pair through an AM26LV32/26LS32-type receiver before the Pico. The Pico counts A/B in PIO; with the 10 nm encoder, 100,000 counts = 1 mm." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#666666;fillColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="540" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="v-002326c41d" value="&lt;b&gt;ViX X3 — RS-232 setup and status&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt; RS-232 GND&lt;br&gt;&lt;b&gt;4&lt;/b&gt; ViX receive — connect from MAX3232 TX&lt;br&gt;&lt;b&gt;5&lt;/b&gt; ViX transmit — connect to MAX3232 RX&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Factory-reset / mode input — &lt;b&gt;leave unconnected&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pico UART is 3.3 V TTL and must pass through a MAX3232. Use RS-232 for configuration checks, PA/PE/fault logging and commissioning; use X4 A/B for real-time position." style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#666666;fillColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="540" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="v-7196007886" value="&lt;b&gt;Ground / shield rule&lt;/b&gt;&lt;br&gt;PE, stage frame, ViX PE, PSU chassis and cable shields terminate at the cabinet/star earth arrangement. Keep motor wiring separated from encoder/control wiring. Use twisted pairs for STEP±, DIR± and encoder A±/B±/Z±." style="shape=note;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#d6b656;fillColor=#fff2cc;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="960" width="1140" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
