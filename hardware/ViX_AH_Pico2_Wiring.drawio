  <diagram id="x3" name="2 - X3 serial cable">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t2" value="X3 special RS-232 cable - not straight-through" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
      <mxCell id="a" value="&lt;b&gt;USB-RS232 adapter / PC DTE side&lt;/b&gt;&lt;br&gt;DB9 female breakout for a typical male adapter&lt;br&gt;2 RX&lt;br&gt;3 TX&lt;br&gt;5 GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="360" height="230" as="geometry"/></mxCell>
      <mxCell id="b" value="&lt;b&gt;ViX X3&lt;/b&gt;&lt;br&gt;DB9 socket on drive; use male breakout&lt;br&gt;4 RX&lt;br&gt;5 TX&lt;br&gt;3 GND&lt;br&gt;&lt;b&gt;Do not connect X3 2, 8 or 9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1050" y="180" width="360" height="250" as="geometry"/></mxCell>
      <mxCell id="w1" value="TX 3 -> RX 4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="250" as="targetPoint"/></mxGeometry></mxCell>
      <mxCell id="note" value="Wire exactly:&lt;br&gt;&lt;b&gt;adapter 3 -> ViX 4&lt;/b&gt;&lt;br&gt;&lt;b&gt;adapter 2 -> ViX 5&lt;/b&gt;&lt;br&gt;&lt;b&gt;adapter 5 -> ViX 3&lt;/b&gt;&lt;br&gt;Shell/shield may be carried shell-to-shell." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="590" y="230" width="330" height="230" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="x4" name="3 - X4 interface">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t3" value="Pico 2 to ViX X4 interface" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
      <mxCell id="p" value="&lt;b&gt;Pico 2&lt;/b&gt;&lt;br&gt;GP2 STEP&lt;br&gt;GP3 DIR&lt;br&gt;GP4/5/6 encoder&lt;br&gt;GP10 fault&lt;br&gt;GP11 enable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="260" height="240" as="geometry"/></mxCell>
      <mxCell id="d" value="&lt;b&gt;AM26LV31E @ 3.3 V&lt;/b&gt;&lt;br&gt;GP2 -> 1A -> 1Y/1Z -> STEP+/-&lt;br&gt;GP3 -> 2A -> 2Y/2Z -> DIR+/-&lt;br&gt;pin4=3V3, pin12=GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="390" height="220" as="geometry"/></mxCell>
      <mxCell id="r" value="&lt;b&gt;AM26LV32E @ 3.3 V&lt;/b&gt;&lt;br&gt;A+/- -> pins2/1 -> pin3 -> GP4&lt;br&gt;B+/- -> pins6/7 -> pin5 -> GP5&lt;br&gt;Z+/- -> pins10/9 -> pin11 -> GP6&lt;br&gt;pin4=3V3, pin12=GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="390" height="250" as="geometry"/></mxCell>
      <mxCell id="x4c" value="&lt;b&gt;ViX X4 HD15&lt;/b&gt;&lt;br&gt;12/7 STEP+/-&lt;br&gt;13/8 DIR+/-&lt;br&gt;14/9 A+/-&lt;br&gt;15/10 B+/-&lt;br&gt;5/4 Z+/-&lt;br&gt;6 fault&lt;br&gt;11 energise&lt;br&gt;3 0V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1120" y="170" width="300" height="390" as="geometry"/></mxCell>
      <mxCell id="io" value="&lt;b&gt;Single-ended&lt;/b&gt;&lt;br&gt;X4-6 -> GP10 + 10k pull-up to 3V3&lt;br&gt;X4-11 -> 2N3904 collector&lt;br&gt;emitter -> X4-3/GND&lt;br&gt;GP11 -> 4.7k -> base&lt;br&gt;100k base-emitter" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="620" width="390" height="210" as="geometry"/></mxCell>
      <mxCell id="e31" value="STEP/DIR logic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p" target="d"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e32" value="STEP+/- DIR+/-" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d" target="x4c"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e33" value="A/B/Z differential" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="x4c" target="r"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e34" value="encoder logic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r" target="p"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
